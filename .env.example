# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hedera_stalker
DB_PASSWORD=hedera_stalker_password
DB_DATABASE=hedera_stalker

# Database Production Settings
# Set to true to automatically create/update tables (enabled by default for convenience)
# After initial deployment, set to false for production safety to prevent accidental schema changes
DB_SYNCHRONIZE=true

# Enable database query logging (set to false in production for better performance)
DB_LOGGING=false

# Hedera Network Configuration
# Options: mainnet, testnet, previewnet
HEDERA_NETWORK=testnet

# Application Configuration
PORT=3000

# Environment
# Set to 'production' when deploying to production
NODE_ENV=development

# Security Configuration
# Generate password hash using: node scripts/generate-password-hash.js <your_password>
# If not set, account creation will be unrestricted (not recommended for production)
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://www.yourdomain.com
# If not set, defaults to localhost origins (development mode)
# In production, always set this to your actual domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Default: true (tables will be auto-created on first run)
